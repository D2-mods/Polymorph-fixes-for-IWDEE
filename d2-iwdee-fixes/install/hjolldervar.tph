/*
Set Join_Posse variable in Kuldahar if not already set (i.e. if you warped there)
This fixes a possible bug with Hjollder's dialogue.
*/


ACTION_IF (RESOURCE_CONTAINS ~AR2109.are~  ~hjollder~) BEGIN

COPY_EXISTING ~AR2109.are~  ~override~
  LPF read_or_set_areascript RET areascript END
BUT_ONLY

ACTION_IF !(RESOURCE_CONTAINS ~areascript.bcs~  ~Join_Posse~) BEGIN
<<<<<<<< .../temp/script
IF
	GlobalLT("Join_Posse","GLOBAL",3)
//	!Global("d2setJoin_Posse","GLOBAL",1)
THEN
	RESPONSE #100
//		SetGlobal("d2setJoin_Posse","GLOBAL",1)
		SetGlobal("Join_Posse","GLOBAL",3)
		Continue()
END
>>>>>>>>
COPY - ~.../temp/script~  ~inlined/script.baf~
  EVALUATE_BUFFER
EXTEND_BOTTOM ~%areascript%.bcs~  ~inlined/script.baf~
END

END


